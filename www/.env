# SAYMAN Wallet Manager Configuration

# API/RPC Node Peers (Comma-separated, automatically falls back if one goes offline)
API_PEERS_TESTNET=https://sayman.onrender.com/api,https://sayman.up.railway.app/api,http://localhost:3000/api
API_PEERS_PUBLIC_TESTNET=https://sayman.onrender.com/api,https://sayman.up.railway.app/api
API_PEERS_MAINNET=https://sayman.onrender.com/api,https://sayman.up.railway.app/api

# Faucet APIs (Comma-separated, automatically falls back if one goes offline)
FAUCET_PEERS_TESTNET=https://sayman.onrender.com/api/faucet,https://sayman.up.railway.app/api/faucet,https://sayman-faucet.onrender.com/request,http://localhost:10000/request
FAUCET_PEERS_PUBLIC_TESTNET=https://sayman.onrender.com/api/faucet,https://sayman.up.railway.app/api/faucet,https://sayman-faucet.onrender.com/request

# Default RPC & Explorer Settings for Primary chain view (support multiple comma-separated fallback peers)
RPC_URL=https://sayman.onrender.com/api,https://sayman.up.railway.app/api
EXPLORER_URL=https://sayman.onrender.com

# GitHub Settings for Wallet APK Update checks
GITHUB_REPO=saymanlal/SAYMAN
GITHUB_BRANCH=main
