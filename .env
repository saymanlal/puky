# SAYMAN Wallet Manager Configuration

# API/RPC Node Peers (Comma-separated, automatically falls back if one goes offline)
API_PEERS_TESTNET=http://localhost:3000/api,https://sayman.up.railway.app/api,https://sayman.onrender.com/api
API_PEERS_PUBLIC_TESTNET=https://sayman.up.railway.app/api,https://sayman.onrender.com/api
API_PEERS_MAINNET=https://sayman.up.railway.app/api,https://sayman.onrender.com/api

# Faucet APIs (Comma-separated, automatically falls back if one goes offline)
FAUCET_PEERS_TESTNET=http://localhost:10000/request,https://sayman-faucet.onrender.com/request,https://sayman.up.railway.app/api/faucet
FAUCET_PEERS_PUBLIC_TESTNET=https://sayman-faucet.onrender.com/request,https://sayman.up.railway.app/api/faucet

# Default RPC & Explorer Settings for Primary chain view (support multiple comma-separated fallback peers)
RPC_URL=https://sayman.up.railway.app/api,https://sayman.onrender.com/api
EXPLORER_URL=https://sayman.onrender.com

# GitHub Settings for Wallet APK Update checks
GITHUB_REPO=saymanlal/SAYMAN
GITHUB_BRANCH=main
